# ===================================================
# Organic Chemistry Structure MCP Server Environment Config
# ===================================================

# Node.js MCP & Express Server Port
PORT=3000

# MCP Endpoint Path
MCP_ENDPOINT=/mcp

# Internal Python RDKit Chemistry Microservice URL
PYTHON_ENGINE_URL=http://127.0.0.1:8000

# SQLite Persistent Cache Database Path
DATABASE_PATH=chem_cache.db

# PubChem PUG REST API Base URL
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# Allowed Origins for CORS & Streamable HTTP Transport (comma separated, or * for all)
ALLOWED_ORIGINS=*

# Rate Limiting (Maximum requests per minute)
RATE_LIMIT_MAX=600

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Optional Authentication Secret for Remote Protected MCP Connections
# AUTH_SECRET=your-secret-token-here
